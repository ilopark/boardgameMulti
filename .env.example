# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 깃에 올라가지 않습니다.
# **접속 문자열은 비밀번호가 들어간 자격증명입니다.** 채팅·이슈·스크린샷에 붙여넣지 마세요.

# ── 서버 ──────────────────────────────────────────────
PORT=3000

# ── DB (Supabase) ─────────────────────────────────────
# 없으면 계정 기능이 꺼지고 게스트로만 게임합니다. 게임 자체는 그대로 돌아갑니다.
#
# 값 찾는 곳: Supabase 대시보드 → 프로젝트 → Connect → "Session pooler"
#   포트 6543(Transaction) 이 아니라 **5432(Session)** 쪽을 쓰세요.
#   Transaction 모드는 prepared statement 를 못 써서 pg 드라이버와 충돌합니다.
#
# 형식: postgresql://postgres.<참조ID>:<비밀번호>@<호스트>:5432/postgres
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────
# 없으면 방이 메모리에만 있고, 서버를 재시작하면 진행 중이던 판이 사라집니다.
#
# 로컬에서 띄우는 법 (--appendonly yes 가 중요합니다.
# 이게 없으면 Redis 가 재시작할 때 방이 날아가서 쓰는 의미가 없습니다):
#   docker run -d --name bg-redis -p 6379:6379 \
#     redis:7-alpine redis-server --appendonly yes
REDIS_URL=redis://localhost:6379
